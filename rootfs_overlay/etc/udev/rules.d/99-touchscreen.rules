# reTerminal: seeed-tp, touch through the panel MCU (mipi-dsi package)
# With tp_rotate=1 in config.txt the driver reports coordinates that match the framebuffer. The matrix turns them for Cog's rotation=3 (COG_PLATFORM_PARAMS in erlinit.config); Cog does
# not rotate touch itself. Emerge reads the device without udev and gets the framebuffer coordinates.
# For another Cog rotation, write a rule to /run/udev/rules.d whose name sorts after this file
# (udev skips a /run file with the same name as one in /etc), e.g. 99-zz-touch-rotation.rules. Matrices:
# rotation=0 "1 0 0 0 1 0", 1 "0 -1 1 1 0 0", 2 "-1 0 1 0 -1 1", 3 "0 1 0 -1 0 1".
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="seeed-tp", \
  ENV{LIBINPUT_CALIBRATION_MATRIX}="0 1 0 -1 0 1", \
  MODE="0666"

# reTerminal DM: GT9271 Goodix touchscreen (directly on I2C, kernel driver)
SUBSYSTEM=="input", KERNEL=="event*", DRIVERS=="Goodix-TS", \
  ENV{ID_INPUT}="1", \
  ENV{ID_INPUT_TOUCHSCREEN}="1", \
  MODE="0666", TAG+="uaccess"
